# Copy to .env.production (gitignored) for local APK / release web builds.
# npm run build:prod validates these before Vite runs.
#
# Do NOT add VITE_OTP_ENABLED here — build:prod fetches it from Vercel Production only.
# See docs/DEPLOY_OTP_CHECK.md and .env.vercel.local.example for Vercel API credentials.

# Required — build:prod fails if missing or not PROD (rpxsyeqskvhjmbkxnpmd)
VITE_ENVIRONMENT=production
VITE_SUPABASE_URL=https://rpxsyeqskvhjmbkxnpmd.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional Firebase web push — src/lib/firebaseWebConfig.ts has PROD fallbacks if unset
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
