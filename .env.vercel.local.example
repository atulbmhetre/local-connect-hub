# Gitignored — local only. Used by `npm run build:prod` / `check:otp-prod`
# to fetch VITE_OTP_ENABLED from Vercel Production. Never put build secrets here
# that belong in Vercel itself (except this API token for local builds).
#
# Create a token: https://vercel.com/account/tokens
# Project id: Vercel → Project → Settings → General → Project ID

VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
